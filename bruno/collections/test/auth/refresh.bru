meta {
  name: refresh
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/api/auth/refresh
  body: json
  auth: inherit
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

vars:post-response {
  accessToken: res.accessToken
  refreshToken: res.refreshToken
}

settings {
  encodeUrl: true
  timeout: 0
}
